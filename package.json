{
  "name": "titanic-4d",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive, source-backed 3D visualization of the sinking of RMS Titanic (14–15 April 1912), navigable in space and time.",
  "license": "MIT",
  "author": "Jonathan About <contact@titanic-4d.org>",
  "homepage": "https://www.titanic-4d.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/j-about/Titanic-4D.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13.0 <27",
    "pnpm": ">=12.18.0 <13"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node tools/precompress.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "biome ci",
    "format": "biome check --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:container": "tools/e2e-container.sh",
    "budgets": "node tools/check-budgets.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm budgets"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.7",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "happy-dom": "21.0.4",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
