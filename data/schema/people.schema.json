{
  "$id": "https://www.titanic-4d.org/schema/people.schema.json",
  "title": "Titanic 4D dataset: people.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "casualty_counts": {
      "minItems": 2,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "rescue": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema8"
      }
    },
    "facts": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema9"
      }
    }
  },
  "required": [
    "casualty_counts",
    "rescue",
    "facts"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema1"
        },
        "holder": {
          "type": "string",
          "minLength": 1
        },
        "aboard": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "saved": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "lost": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "breakdown": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema2"
          }
        },
        "source_ids": {
          "$ref": "#/$defs/__schema3"
        },
        "certainty": {
          "$ref": "#/$defs/__schema4"
        },
        "note": {
          "$ref": "#/$defs/__schema5"
        },
        "alternatives": {
          "$ref": "#/$defs/__schema6"
        }
      },
      "required": [
        "id",
        "holder",
        "aboard",
        "saved",
        "lost",
        "source_ids",
        "certainty",
        "note"
      ],
      "additionalProperties": false
    },
    "__schema1": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "group": {
          "type": "string",
          "minLength": 1
        },
        "aboard": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "saved": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "lost": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "group",
        "aboard",
        "saved",
        "lost"
      ],
      "additionalProperties": false
    },
    "__schema3": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    },
    "__schema4": {
      "type": "string",
      "enum": [
        "established",
        "estimated",
        "debated"
      ],
      "description": "established: primary evidence and broad consensus; estimated: derived or approximate, with the method stated in the note; debated: competing positions exist and are listed."
    },
    "__schema5": {
      "type": "string",
      "minLength": 1
    },
    "__schema6": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema7"
      }
    },
    "__schema7": {
      "type": "object",
      "properties": {
        "holder": {
          "type": "string",
          "minLength": 1
        },
        "position": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        }
      },
      "required": [
        "holder",
        "position",
        "source_ids"
      ],
      "additionalProperties": false
    },
    "__schema8": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema1"
        },
        "carpathia_time": {
          "type": "string",
          "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
        },
        "ats": {
          "type": "string",
          "pattern": "^1912-04-1[45]T(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d)?$",
          "description": "Equivalent Titanic ship's time, a bookkeeping convention after the foundering."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "$ref": "#/$defs/__schema3"
        },
        "certainty": {
          "$ref": "#/$defs/__schema4"
        },
        "note": {
          "$ref": "#/$defs/__schema5"
        },
        "alternatives": {
          "$ref": "#/$defs/__schema6"
        }
      },
      "required": [
        "id",
        "carpathia_time",
        "ats",
        "title",
        "description",
        "source_ids",
        "certainty",
        "note"
      ],
      "additionalProperties": false
    },
    "__schema9": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema1"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "$ref": "#/$defs/__schema3"
        },
        "certainty": {
          "$ref": "#/$defs/__schema4"
        },
        "note": {
          "$ref": "#/$defs/__schema5"
        },
        "alternatives": {
          "$ref": "#/$defs/__schema6"
        }
      },
      "required": [
        "id",
        "title",
        "summary",
        "source_ids",
        "certainty",
        "note"
      ],
      "additionalProperties": false
    }
  }
}
