{
  "$id": "https://www.titanic-4d.org/schema/lighting.schema.json",
  "title": "Titanic 4D dataset: lighting.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "facts": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "output": {
      "minItems": 2,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema7"
      }
    }
  },
  "required": [
    "facts",
    "output"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema1"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "$ref": "#/$defs/__schema2"
        },
        "certainty": {
          "$ref": "#/$defs/__schema3"
        },
        "note": {
          "$ref": "#/$defs/__schema4"
        },
        "alternatives": {
          "$ref": "#/$defs/__schema5"
        }
      },
      "required": [
        "id",
        "title",
        "summary",
        "source_ids",
        "certainty",
        "note"
      ],
      "additionalProperties": false
    },
    "__schema1": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "__schema2": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    },
    "__schema3": {
      "type": "string",
      "enum": [
        "established",
        "estimated",
        "debated"
      ],
      "description": "established: primary evidence and broad consensus; estimated: derived or approximate, with the method stated in the note; debated: competing positions exist and are listed."
    },
    "__schema4": {
      "type": "string",
      "minLength": 1
    },
    "__schema5": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema6"
      }
    },
    "__schema6": {
      "type": "object",
      "properties": {
        "holder": {
          "type": "string",
          "minLength": 1
        },
        "position": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        }
      },
      "required": [
        "holder",
        "position",
        "source_ids"
      ],
      "additionalProperties": false
    },
    "__schema7": {
      "type": "object",
      "properties": {
        "ats": {
          "type": "string",
          "pattern": "^1912-04-1[45]T(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d)?$",
          "description": "Titanic ship's time (Apparent Time Ship), ISO 8601 local date-time."
        },
        "output": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Electrical lighting output as a fraction of normal, before any lamp is submerged."
        },
        "source_ids": {
          "$ref": "#/$defs/__schema2"
        },
        "certainty": {
          "$ref": "#/$defs/__schema3"
        },
        "note": {
          "$ref": "#/$defs/__schema4"
        },
        "alternatives": {
          "$ref": "#/$defs/__schema5"
        }
      },
      "required": [
        "ats",
        "output",
        "source_ids",
        "certainty",
        "note"
      ],
      "additionalProperties": false
    }
  }
}
