# Declarations for the part of Blender's ``mathutils`` module used by the asset pipeline.

from collections.abc import Sequence
from typing import Self

class Euler: ...

class Quaternion:
    def to_euler(self) -> Euler: ...

class Vector:
    def __init__(self, components: Sequence[float]) -> None: ...
    def __sub__(self, other: Self) -> Self: ...
    def to_track_quat(self, track: str, up: str) -> Quaternion: ...
